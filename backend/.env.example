# --- GenAI ---
# Select the provider to use: anthropic or gemini
AI_PROVIDER=gemini

# Anthropic (Claude) API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini API key. Works with the free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Auth ---
# Random long secret used to sign session JWTs (openssl rand -hex 32)
JWT_SECRET=

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Storage ---
# Local JSON file "database" for the hackathon/demo build.
# Swap DB_ADAPTER=firestore + the FIREBASE_* vars below for production.
DB_ADAPTER=json
DATA_DIR=./data


# --- Uploads ---
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_CLAIM=8
